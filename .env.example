# ── Supabase (pre-populated, do not change) ──────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ── UltimatePOS Server-Side Credentials ────────────────────────────────
# These are used ONLY by edge functions (server-side).
# NEVER prefix with VITE_ — that would expose them to the browser.
ULTIMATEPOS_BASE_URL=
ULTIMATEPOS_CLIENT_ID=
ULTIMATEPOS_CLIENT_SECRET=
ULTIMATEPOS_USERNAME=
ULTIMATEPOS_PASSWORD=
ULTIMATEPOS_LOCATION_ID=

# ── KioskPOS API Gateway Settings ───────────────────────────────────────
# Set to true during development to use mock data instead of real UltimatePOS
ULTIMATEPOS_MOCK_MODE=true
